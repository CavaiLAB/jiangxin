{
  "name": "@jx/ui-kit",
  "version": "0.1.0",
  "private": true,
  "description": "匠心自己的界面组件包：DSH 没有的基础组件（shadcn 命令行生成，底下是 Base UI，样式是带 jx: 前缀的 Tailwind）和手写组件，外加在 DSH 仓库之外构建插件的脚本。",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tailwind.css": "./src/styles/jx.tailwind.css",
    "./css-modules": "./src/css-modules.d.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "jx-dsh-plugin-build": "./tools/build-plugin.mjs"
  },
  "files": [
    "src",
    "tools",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/",
    "ui:add": "node tools/shadcn-add.mjs",
    "ui:adapt": "node tools/adapt-generated.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tailwindcss/cli": "4.3.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.2",
    "esbuild": "0.28.2",
    "lightningcss": "1.33.0",
    "lucide-react": "1.70.0",
    "react-day-picker": "10.0.2",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3"
  }
}
