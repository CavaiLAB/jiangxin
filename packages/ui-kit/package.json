{
  "name": "@jx/ui-kit",
  "version": "0.1.0",
  "private": true,
  "description": "匠心自己的界面组件包（按 DSH 的写法：React 18、CSS Modules、--dsw-* 变量），外加在 DSH 仓库之外构建插件的脚本。",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./css-modules": "./src/css-modules.d.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "jx-dsh-plugin-build": "./tools/build-plugin.mjs"
  },
  "files": [
    "src",
    "tools",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "lightningcss": "1.33.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3"
  }
}
